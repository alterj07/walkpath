---
import Base from '../layouts/Base.astro';
import ExploreTable from '../components/ExploreTable.tsx';
---

<Base title="US tech internships, updated hourly" current="explore">
  <div class="hero">
    <h1>Every open US tech internship and new-grad role, polled hourly from employers' own job boards</h1>
    <p>
      Free, no account. Showing roles posted in the last 24 hours by default; widen the window or
      filter by role family, state, season and work arrangement. Links go straight to the employer.
    </p>
  </div>
  <ExploreTable client:load />
</Base>
