{
  "name": "walkpath",
  "private": true,
  "version": "0.1.0",
  "description": "Free US tech-internship board that polls public ATS job-board APIs hourly and publishes a static site.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "npm run build --workspace @walkpath/site",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "26.6.4",
    "eslint": "9.39.5",
    "eslint-plugin-react": "7.37.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vitest": "3.2.7"
  }
}
